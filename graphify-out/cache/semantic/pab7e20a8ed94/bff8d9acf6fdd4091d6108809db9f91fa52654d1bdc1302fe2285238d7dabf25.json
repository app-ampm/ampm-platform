{"nodes": [{"id": "docs_user_flows_user_flow_diagrams", "label": "AMPM User-Flow Diagrams (DRAFT v0.2)", "file_type": "document", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_user_flows_flow_conventions", "label": "Flow diagram conventions", "file_type": "concept", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rectangles are screens or actions labelled with wireframe IDs, diamonds decisions, rounded boxes status changes matching permission-matrix \u00a77; swimlanes group by actor; every flow ends in a state the data model can represent."}, {"id": "docs_user_flows_assumptions_register", "label": "Flow assumptions register (U-1 to U-12)", "file_type": "concept", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_user_flows_u_1_demo_access_granted_by_sales", "label": "U-1 Demo access granted by Sales with OTP login", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No self-serve demo: Sales authorises the demo from the lead record because WHY \u00a74 forbids self-registration; AMPM confirmed with OTP login and an optional 15 to 20 minute Zoom call."}, {"id": "docs_user_flows_u_2_subscription_purchased_in_portal", "label": "U-2 Subscription purchased inside the portal", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Account created by AMPM; the client completes basic wedding details then pays online only by card or UPI; anonymous checkout would contradict WHY \u00a74."}, {"id": "docs_user_flows_u_3_chargeable_hotel_services", "label": "U-3 Availability check included, other hotel services chargeable", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Availability checks are part of the subscription; negotiation, site visits, contract review and booking assistance need an accepted service agreement; fees for those not yet decided."}, {"id": "docs_user_flows_u_4_on_behalf_decisions", "label": "U-4 On-behalf client decisions with evidence", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the family decides by phone the Project Manager records the decision with a note or record so the audit log shows who recorded it."}, {"id": "docs_user_flows_u_5_guest_list_and_links", "label": "U-5 Guest list, per-side links and locked submissions", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links per side or combined; guests identify their household; no editing after submission; corrections through the RSVP team; reminders then calls, with assisted entry writing the same rows."}, {"id": "docs_user_flows_u_6_project_created_on_agreement", "label": "U-6 Project created on accepted broader-services agreement", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project creation back-fills saved hotels, enquiries and agreements; AMPM records the agreement and creates the project."}, {"id": "docs_user_flows_u_7_offline_execution", "label": "U-7 Offline operation during execution", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staff phones have intermittent connectivity inside venues; run-of-show, checklists and arrival lists are readable offline, cue updates and incidents queue and sync. AMPM: required, not optional."}, {"id": "docs_user_flows_u_8_closure_feedback_and_access_window", "label": "U-8 Closure feedback, three-month read-only window, archive on approval", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_user_flows_u_9_sign_in_methods", "label": "U-9 Sign-in methods per principal", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AMPM changed to OTP sign-in for clients; staff method open; guests never sign in and use token links."}, {"id": "docs_user_flows_u_10_notification_channel_preference", "label": "U-10 Notifications by preferred channel with WhatsApp opt-in", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_user_flows_u_11_material_change_thresholds", "label": "U-11 Material change thresholds raise impact flags", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thresholds are configuration, still to be defined by AMPM."}, {"id": "docs_user_flows_u_12_questions_and_live_chat", "label": "U-12 Questions as tracked requests plus live chat", "file_type": "rationale", "source_file": "docs/user-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Originally no free-form chat; AMPM added live