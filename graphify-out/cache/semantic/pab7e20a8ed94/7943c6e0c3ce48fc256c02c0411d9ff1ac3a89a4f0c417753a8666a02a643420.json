n": null, "weight": 1.0}, {"source": "docs_review_open_decisions_assumed_q6_the_eleven_spec_roles_stand_with_scoped_cost_and_margin_visibility", "target": "docs_requirements_audit_q6_roles", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/review/open-decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_review_open_decisions_assumed_q7_private_rsvp_link_per_household_with_the_guest_list_loaded_first", "target": "docs_requirements_audit_q7_guest_identity_in_the_rsvp_portal", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/review/open-decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_review_open_decisions_assumed_q8_identity_documents_off_by_default_never_aadhaar_deleted_30_days_after_checkout", "target": "docs_requirements_audit_q8_identity_documents", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/review/open-decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_review_open_decisions_assumed_q9_seasonal_rate_card_with_line_items_availability_answered_per_enquiry_media_only_with_consent", "target": "docs_requirements_audit_q9_hotel_data", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/review/open-decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_review_open_decisions_assumed_q10_demo_and_trial_full_hotel_assistance_online_payment_and_website_editing_all_in_phase_1", "target": "docs_requirements_audit_q10_phase_1_scope", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/review/open-decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_review_open_decisions_assumed_q11_email_whatsapp_and_sms_through_business_providers", "target": "docs_requirements_audit_q11_guest_and_client_communication_channels", "relation": "refer