{"nodes": [{"id": "reference_docs_why_ampm_app", "label": "Why AMPM App", "file_type": "document", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "pages 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Argues that AMPM is a private, paid, client-based wedding management platform with a public marketing website and a controlled demo-to-client funnel, not a public app with open registration; this protects the proprietary hotel database and makes the software a paid business asset rather than a free public tool."}, {"id": "reference_docs_why_ampm_app_private_paid_client_based_platform", "label": "AMPM as a Private, Paid, Client-Based Platform", "file_type": "rationale", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeing AMPM, trying a limited demo, purchasing a subscription and receiving full wedding-project access are four different stages; the public website exists to attract, explain, demonstrate value and convert prospects into paying customers."}, {"id": "reference_docs_why_ampm_app_customer_journey", "label": "Five-Stage Customer Journey", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_stage1_public_website", "label": "Stage 1 \u2014 Public AMPM Website (open to everyone; no private app or full hotel database access)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_stage2_demo_or_trial", "label": "Stage 2 \u2014 Demo or Limited Free Trial (demo video, guided demo or time-limited restricted trial for prospects)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_stage3_paid_subscription", "label": "Stage 3 \u2014 Paid Subscription (AMPM creates the account; access to the purchased module/package per plan and permissions)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_stage4_wedding_project_creation", "label": "Stage 4 \u2014 Wedding Project Creation (AMPM configures modules and adds wedding information, team, budget, venues, guests, vendors)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_stage5_full_authorised_access", "label": "Stage 5 \u2014 Full Authorised Access (client and authorised AMPM team use the agreed modules under access controls)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_subscription_vs_wedding_service", "label": "App Subscription Is Not the Complete Wedding Planning Service", "file_type": "rationale", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paying for an app subscription does not automatically mean a client has purchased AMPM's complete wedding planning and execution service; these are separate commercial offerings even if they work together."}, {"id": "reference_docs_why_ampm_app_three_distinct_environments", "label": "Three Distinct Environments (public website, demo/trial environment, private AMPM platform)", "file_type": "rationale", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system should have three distinct environments, not one public app with open registration."}, {"id": "reference_docs_why_ampm_app_demo_trial_environment", "label": "Demo / Trial Environment (approved prospects explore selected features with sample data or limited permissions)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_private_ampm_platform", "label": "Private AMPM Platform (accounts authorised by AMPM access purchased modules, private hotel data and authorised wedding projects)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_hotel_database_private_resource", "label": "Hotel Database as a Private AMPM Resource (not a public directory)", "file_type": "rationale", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "pages 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public visitors see only selected examples or previews; prospects see sample data in the demo; authorised subscribers access the module per plan; selections connect to the wedding once a project exists."}, {"id": "reference_docs_why_ampm_app_hotel_discovery_across_funnel", "label": "Hotel Discovery Feature Across the Funnel (preview -> demo sample data -> subscriber module -> AMPM shortlisting help -> connected to wedding project)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_access_control_rules", "label": "Access-Control Rules to Implement from the Beginning", "file_type": "rationale", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No public self-registration; AMPM admins create/approve accounts; module entitlements per subscription; subscription and wedding engagement tracked separately; full project access only after commercial approval and onboarding; per-wedding isolation; demo data separate; expiry/cancellation/upgrade without deleting wedding records."}, {"id": "reference_docs_why_ampm_app_no_public_self_registration", "label": "No Public Self-Registration; AMPM Administrators Create or Approve Client Accounts", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_module_entitlements_per_subscription", "label": "Each Account Receives Only the Modules Included in Its Subscription", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_per_wedding_project_isolation", "label": "Each Wedding Is a Separate Project (own budget, guests, vendors, documents, approvals, permissions)", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_demo_data_separation", "label": "Demo Data Must Remain Separate from Real Client Data", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_subscription_expiry_without_deletion", "label": "Subscription Expiry, Cancellation and Upgrades Control Access Without Deleting Wedding Records", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reference_docs_why_ampm_app_demo_to_client_onboarding_funnel", "label": "Controlled Demo-to-Client Onboarding Funnel", "file_type": "concept", "source_file": "reference_docs/Why AMPM App.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "reference_docs_why_ampm_app", "target": "reference_docs_why_ampm_app_private_paid_client_based_platform", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference_docs/Why AMPM App.pdf", "source_location": null, "weight": 1.0}, {"source": "reference_docs_why_ampm_app", "target": "reference_docs_why_ampm_app_customer_journey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference_docs/Why AMPM App.pdf", "source_location": null, "weight": 1.0}, {"source": "reference_docs_why_ampm_app", "target": "reference_docs_why_ampm_app_three_distinct_environments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference_docs/Why AMPM App.pdf", "source_location": null, "weight": 1.0}, {"source": "reference_docs_why_ampm_app", "target": "reference_docs_why_ampm_app_hotel_database_private_resource", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference_docs/Why AMPM App.pdf", "source_location": null, "weight": 1.0}, {"source": "reference_docs_why_ampm_app", "target": "reference_docs_why_ampm_app_access_control_rules", "relation": "references", "confiden