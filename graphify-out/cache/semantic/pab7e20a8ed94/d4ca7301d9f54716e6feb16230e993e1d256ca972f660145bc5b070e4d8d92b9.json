", "target": "docs_engineering_platform_options_option_g2_full_vps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_r13", "target": "docs_engineering_platform_options_option_b_aws_lite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_option_b_aws_lite", "target": "docs_engineering_platform_options_option_a_aws_drafted", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_option_g1_hybrid_vps", "target": "docs_engineering_platform_options_option_g2_full_vps", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_option_c_supabase", "target": "docs_engineering_platform_options_supabase_auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_option_c_supabase", "target": "docs_engineering_platform_options_s3_identity_hybrid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_option_a_aws_drafted", "target": "docs_engineering_platform_options_cognito", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "