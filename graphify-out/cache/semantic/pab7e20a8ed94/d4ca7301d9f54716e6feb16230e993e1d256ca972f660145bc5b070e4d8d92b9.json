{"nodes": [{"id": "docs_engineering_platform_options_document", "label": "Data Platform and Identity: Options and Prices", "file_type": "document", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_platform_options_option_a_aws_drafted", "label": "Option A: AWS as drafted", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full enterprise posture (two Indian regions, per-bucket KMS keys, WAF, rehearsed recovery); highest ops load and bill (US$450-900/mo at launch) but no redesign."}, {"id": "docs_engineering_platform_options_option_b_aws_lite", "label": "Option B: AWS lite growing into A", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended before the VPS was known: same Terraform at a quarter of cost during build (US$180-250/mo), Multi-AZ and the Hyderabad copy switched on at launch with no migration; Cognito identity free."}, {"id": "docs_engineering_platform_options_option_c_supabase", "label": "Option C: Supabase Pro in Mumbai", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Least operations and bundled identity; gives up the second region and customer keys; the S3 Mumbai identity bucket hybrid restores the key that matters; recommended if AWS is unfamiliar (K4)."}, {"id": "docs_engineering_platform_options_option_d_digitalocean", "label": "Option D: DigitalOcean in Bangalore", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simplest console and lowest bill with managed PostgreSQL PITR and a standby; no second region, no KMS; identity must come from Cognito or Supabase Auth."}, {"id": "docs_engineering_platform_options_option_e_gcp", "label": "Option E: Google Cloud in Mumbai", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equivalent posture with Delhi as a second region but a full infra redesign; Identity Platform phone OTP ~US$0.07/SMS so OTP stays in the API with MSG91."}, {"id": "docs_engineering_platform_options_option_f_azure", "label": "Option F: Azure in Central India", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equivalent posture (Chennai as a second region) but a full infra redesign; right only if the developer already knows Azure."}, {"id": "docs_engineering_platform_options_option_g1_hybrid_vps", "label": "Option G1: Hybrid VPS + managed data", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VPS runs the application; PostgreSQL/PITR, S3 and Cognito managed elsewhere; the box rebuilt from Compose in an hour; cheapest sound build-time platform."}, {"id": "docs_engineering_platform_options_option_g2_full_vps", "label": "Option G2: Everything on the VPS (DECIDED)", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locked 26 Oct 2026: PostgreSQL, files (MinIO/S3) and an optional self-hosted IdP all on the box; cheapest by far and the most ways to lose data; the brief's security is met only if part 7.2 is done in full."}, {"id": "docs_engineering_platform_options_r13", "label": "R13 hosting decision", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locked 26 Oct 2026 as G2 (dedicated VPS); the recommendation before the VPS was Option B, else C with the S3 identity hybrid; an Indian datacentre is a condition."}, {"id": "docs_engineering_platform_options_supabase_auth", "label": "Supabase Auth (identity option)", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With Option C: email verification, phone OTP via the send-SMS hook to MSG91, TOTP MFA, admin-created users; included in Pro."}, {"id": "docs_engineering_platform_options_cognito", "label": "Amazon Cognito (identity, recommended)", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Usable from any host; 10,000 MAU free then US$0.015/user; custom SMS sender to a DLT provider via a Lambda; effectively free for AMPM for years."}, {"id": "docs_engineering_platform_options_firebase_identity", "label": "Firebase Auth / Identity Platform", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phone OTP goes through Google SMS ~US$0.07/message to India and cannot use the DLT provider; wrong tool for mobile-OTP sign-in in India."}, {"id": "docs_engineering_platform_options_clerk", "label": "Clerk (identity option)", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted components; per-message phone OTP; data held outside India; adds a dependency for little gain."}, {"id": "docs_engineering_platform_options_auth0", "label": "Auth0 (identity option)", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Priced for enterprises (US$70/mo at 1,000 users rising steeply); not justified."}, {"id": "docs_engineering_platform_options_keycloak_zitadel", "label": "Self-hosted Keycloak / Zitadel", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free software but more operations for one developer; right only if a self-hosted IdP is wanted for other reasons."}, {"id": "docs_engineering_platform_options_in_api_auth", "label": "In-API auth (T-6 original)", "file_type": "rationale", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Argon2id/OTP/TOTP/sessions via Better Auth; free and bounded but the developer owns the security; the standards review recommended a managed service instead."}, {"id": "docs_engineering_platform_options_msg91", "label": "MSG91 (Indian DLT-registered SMS provider)", "file_type": "concept", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_platform_options_s3_identity_hybrid", "label": "S3 Mumbai identity-document bucket (hybrid)", "file_type": "concept", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An S3 bucket in Mumbai with its own KMS key for identity documents (~US$5), keeping per-key control under Supabase (Option C)."}, {"id": "docs_engineering_platform_options_india_residency", "label": "India data residency requirement", "file_type": "concept", "source_file": "docs/engineering/platform-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Should, treated as must (brief security posture); rules out Neon, Railway/Render (Singapore), Hetzner, and Cloudflare R2 for identity documents."}], "edges": [{"source": "docs_engineering_platform_options_document", "target": "docs_engineering_platform_options_r13", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_document", "target": "docs_engineering_platform_options_option_a_aws_drafted", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_document", "target": "docs_engineering_platform_options_option_b_aws_lite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_document", "target": "docs_engineering_platform_options_option_c_supabase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/platform-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_platform_options_document", "target": "docs_engineering_platform_options_option_