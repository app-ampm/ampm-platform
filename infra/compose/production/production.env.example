# Example of the production.env the deploy decrypts from infra/secrets/*.enc.yaml (sops+age, feature
# 6.4) on the host at deploy time. The real file is NEVER committed; these are non-secret placeholders
# that document the keys the production stack consumes. Copy to production.env for a local dry run.
NODE_ENV=production
PORT=3900

# Postgres (internal network). POSTGRES_* configure the postgres container; DATABASE_URL is the app's.
POSTGRES_USER=ampm
POSTGRES_PASSWORD=change-me-via-sops
POSTGRES_DB=ampm
DATABASE_URL=postgresql://ampm:change-me-via-sops@postgres:5432/ampm
# pgBackRest and the backup sidecar authenticate to Postgres via libpq, which reads PGPASSWORD; pg_hba is
# scram-only, so there is no password-less path. Must equal POSTGRES_PASSWORD. Without it, stanza-create,
# backup and check all fail, archive-push then fails every WAL segment, and pg_wal fills the disk.
PGPASSWORD=change-me-via-sops

# pgBackRest (feature 6.3): the encrypted S3 repo in Mumbai. The postgres container (archive_command)
# and the pgbackrest container both read these. The repo is ALWAYS encrypted — the cipher pass is
# required, and losing it loses the backups. PGBACKREST_REPO1_PATH is the prefix inside the bucket
# (overrides the posix default in infra/pgbackrest/pgbackrest.conf). All of these come from sops.
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=/ampm
PGBACKREST_REPO1_S3_BUCKET=ampm-backups
PGBACKREST_REPO1_S3_ENDPOINT=s3.ap-south-1.amazonaws.com
PGBACKREST_REPO1_S3_REGION=ap-south-1
PGBACKREST_REPO1_S3_KEY=change-me-via-sops
PGBACKREST_REPO1_S3_KEY_SECRET=change-me-via-sops
PGBACKREST_REPO1_CIPHER_PASS=change-me-via-sops

# Redis (internal network, password-protected). The redis container requires REDIS_PASSWORD at start
# (it refuses to run unauthenticated), and the password inside REDIS_URL must match REDIS_PASSWORD.
REDIS_PASSWORD=change-me-via-sops
REDIS_URL=redis://:change-me-via-sops@redis:6379

# Identity: production uses Amazon Cognito (Mumbai) — never the local provider.
IDENTITY_PROVIDER=cognito
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Behind Caddy: the real client IP, the public domain and the link base.
TRUST_PROXY=1
# NOTE: AMPM_DOMAIN and ACME_EMAIL are NOT here. The Caddy edge receives them as compose
# interpolation vars (the deploy's shell env / compose-dir .env, like AMPM_IMAGE), never via this
# env_file — the edge container gets no backend secrets. The deploy must set both (compose `:?` enforces it).
WEB_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Email over SMTP/SES (feature 5.3).
EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_USER=change-me-via-sops
SMTP_PASSWORD=change-me-via-sops
EMAIL_FROM=AMPM <no-reply@example.com>

# NOTE: AMPM_IMAGE is NOT set here. Compose reads ${...} interpolation from the shell env or a
# compose-dir .env, never from env_file, so the deploy workflow (feature 6.6) exports the released,
# digest-pinned image there — not in this file.
