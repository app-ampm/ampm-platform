# Example of the staging.env the deploy decrypts from infra/secrets/*.enc.yaml (sops+age, feature 6.4).
# The real file is NEVER committed; these are non-secret placeholders. Same keys as
# ../production/production.env.example, with staging's own database, domain and image tag.
NODE_ENV=production
PORT=3900

POSTGRES_USER=ampm
POSTGRES_PASSWORD=change-me-via-sops
POSTGRES_DB=ampm_staging
DATABASE_URL=postgresql://ampm:change-me-via-sops@postgres:5432/ampm_staging

# The redis container requires REDIS_PASSWORD at start; the password in REDIS_URL must match it.
REDIS_PASSWORD=change-me-via-sops
REDIS_URL=redis://:change-me-via-sops@redis:6379

IDENTITY_PROVIDER=cognito
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

TRUST_PROXY=1
# AMPM_DOMAIN and ACME_EMAIL are compose interpolation vars the deploy sets (shell/.env, like
# AMPM_IMAGE), not env_file entries — the edge container gets no backend secrets.
WEB_APP_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com

EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_USER=change-me-via-sops
SMTP_PASSWORD=change-me-via-sops
EMAIL_FROM=AMPM Staging <no-reply@staging.example.com>

# NOTE: AMPM_IMAGE is not set here — it is an interpolation-time variable the deploy workflow exports
# in the shell env / compose-dir .env (feature 6.6), not a container env var.
