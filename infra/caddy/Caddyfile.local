{
	# Local smoke only: no TLS, no admin API. Prove that Caddy fronts the API and that only Caddy
	# publishes a port. The real Caddyfile (TLS, HSTS, security headers, edge rate limits on sign-in /
	# OTP / public forms, the static public site, the WebSocket upgrade) lands in feature 6.2.
	admin off
	auto_https off
}

:8080 {
	reverse_proxy api:3900
}
