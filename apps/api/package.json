{
  "name": "api",
  "version": "0.0.1",
  "description": "AMPM API and worker: NestJS modular monolith with Prisma on PostgreSQL.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "dev": "nest start --watch --env-file .env",
    "dev:token": "node --env-file-if-exists=.env --import tsx scripts/dev-token.ts",
    "lint": "eslint .",
    "start": "nest start --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:prod": "node dist/main",
    "test": "vitest run && vitest run --config ./vitest.config.e2e.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ampm/core": "workspace:*",
    "@ampm/policy": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
