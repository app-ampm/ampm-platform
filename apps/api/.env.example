# Copy to .env for local development only; never commit .env (secrets live in sops-encrypted files on the VPS).
NODE_ENV=development
PORT=3900
LOG_LEVEL=debug
DATABASE_URL="postgresql://ampm:ampm@localhost:5432/ampm?schema=public"

# Identity (T-6). Production uses Cognito; `local` is for development and tests only and is refused in production.
IDENTITY_PROVIDER=local
# At least 32 characters; signs the local development tokens (`pnpm --filter api dev:token`). Replace the
# placeholder with the output of `openssl rand -base64 48`: anyone can read it in the repository.
IDENTITY_LOCAL_SECRET=change-me-to-a-long-random-development-secret
# Browser origins of the client portals' web build; development defaults to the local Metro and Next servers.
# CORS_ORIGINS=https://app.example.com
# COGNITO_REGION=ap-south-1
# COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# The e2e tests migrate and seed this database on every run; never point it at real data.
DATABASE_URL_TEST="postgresql://ampm:ampm@localhost:5432/ampm_test?schema=public"

# Custom roles (D-036) are off by default (seed roles only). The permission-set and role e2e tests,
# and local work on them, need it on; CI sets it explicitly.
DYNAMIC_ROLES=true

# Jobs (D-031). Leave REDIS_URL unset to run jobs inline (development without Redis, and tests);
# set it to run BullMQ on Redis. JOB_WORKER=true only in the separate worker process (`pnpm --filter
# api worker`); the API process enqueues but does not consume.
# REDIS_URL="redis://localhost:6379"
# JOB_WORKER=false

# Production-only settings (feature 5.4 / 5.2 / 5.3). Each has a safe development default above or in the
# schema, but startup refuses them in production unless set to real values:
# TRUST_PROXY   — proxy hop count so req.ip is the real client for rate limits and audit. 0 (dev default)
#                 trusts nobody; behind Caddy it MUST be the number of trusted hops, e.g. 1.
# WEB_APP_URL   — non-localhost base URL the invite/notification links point to.
# EMAIL_PROVIDER=smtp with SMTP_HOST/SMTP_USER/SMTP_PASSWORD and a verified non-localhost EMAIL_FROM.
# TRUST_PROXY=1
# WEB_APP_URL=https://app.example.com
# EMAIL_PROVIDER=smtp
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# EMAIL_FROM="AMPM <no-reply@example.com>"
