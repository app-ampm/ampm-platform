# Copy to .env for local development only; never commit .env. Expo inlines EXPO_PUBLIC_* values into the
# bundle at build time, so nothing secret belongs here.
# The API the app talks to (pnpm dev --filter=api serves it on 3900).
EXPO_PUBLIC_API_URL=http://localhost:3900
# Development only, until the sign-in screens arrive: paste a token from `pnpm --filter api dev:token local:admin`.
# It expires after twelve hours. Only development builds read it (src/lib/env.ts checks __DEV__), so a
# production export leaves it out of the bundle even while this file holds it.
# EXPO_PUBLIC_DEV_ACCESS_TOKEN=
