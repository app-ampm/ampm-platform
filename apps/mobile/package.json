  "scripts": {
    "start": "expo start",
    "android": "APP_VARIANT=development expo run:android --port 8082",
    "ios": "APP_VARIANT=development expo run:ios --port 8082",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist",
    "lint": "eslint . && node ../../packages/config/tailwind/class-audit.mjs native src",
    "test": "jest --passWithNoTests",
    "dev": "expo start --port 8082",
    "native:prebuild": "APP_VARIANT=development expo prebuild --clean",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "bundle:check": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_DEV_ACCESS_TOKEN=not-a-token-bundle-check-marker expo export --platform all --output-dir dist && ! grep -rl not-a-token-bundle-check-marker dist"
  },
  "private": true,
  "description": "AMPM client app and team app: iOS, Android, tablets, and the web export of the client portals."
