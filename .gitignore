# AMPM platform project repository

# The Obsidian vault is its own repository (ampm-vault)
vault/

# Tooling output
docs/tools/node_modules/
docs/site/

# Local state
.obsidian/
.DS_Store
.claude/settings.local.json

# 173 MB export, not a source
/Audit- AMPM.pdf

# Python caches
__pycache__/
*.pyc

# Knowledge graph (graphify-out/ is committed so every checkout and worktree has it); these are per-machine or temporary
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_*.json
graphify-out/.graphify_*.txt
graphify-out/.needs_update
# graphify writes a dated backup of the curated graph on each rebuild; it is a local artifact, not committed.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
!graphify-out/.graphify_labels.json
.claude/settings.json.graphify-bak

# Monorepo (apps/ and packages/): installs and build outputs, never committed
node_modules/
.pnpm-store/
.turbo/
dist/
build/
coverage/
*.tsbuildinfo
.next/
out/
.expo/
expo-env.d.ts
ios/
android/
*.orig.*
web-build/
.env
.env.*
!.env.example
# Decrypted secret env files for the Compose stacks (sops produces these at deploy; never commit them).
infra/compose/**/*.env
# Decrypted monitoring secret (the Alertmanager paging webhook URL, feature 6.7); produced at deploy.
infra/compose/**/monitoring-secrets/
# Rendered Prometheus blackbox edge-probe target (holds the env's domain); produced at deploy.
infra/compose/**/monitoring-targets/
# sops secrets (feature 6.4): commit only the encrypted *.enc.yaml and the examples/ templates — never a
# plaintext secret source, an age private key, or any private key (at any depth).
infra/secrets/**/*.yaml
!infra/secrets/**/*.enc.yaml
!infra/secrets/examples/*.yaml
age.key
*.agekey
*.age
*.key
age-key*.txt
key.txt
keys.txt
prisma/*.db

# Per-machine dev-server launch config for the Claude desktop app (absolute paths, local ports)
.claude/launch.json

# Prisma client, generated by `pnpm db:generate`
apps/api/src/generated/
