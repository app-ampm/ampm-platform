{
  "name": "@ampm/web-forms",
  "version": "0.0.0",
  "private": true,
  "description": "The public website's plain-HTML form fields (D-175): presentational DOM controls styled with the kit's recipes from @ampm/ui/styles, shared by the contact form and the hotel information form. No fetching, no upload logic; state and validation stay with the forms.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "lint": "eslint . && node ../config/tailwind/class-audit.mjs web src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ampm/ui": "workspace:*"
  },
  "devDependencies": {
    "@ampm/config": "workspace:*",
    "@ampm/tokens": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "^19",
    "jsdom": "26.1.0",
    "postcss": "^8.5.31",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
