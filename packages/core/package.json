{
  "name": "@ampm/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript: domain types, Zod schemas, business rules, constants, errors, logger, i18n keys. No React, no I/O (.claude/rules/api.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@ampm/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
