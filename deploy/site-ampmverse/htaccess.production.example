# .htaccess for site.ampmverse.com: the PRODUCTION public website on the shared Plesk box (D-138). Copy
# it to the site's document root. Nothing deploys over it: the site lives in the production stack's web
# container (compose.box.yml, 127.0.0.1:7102), not in the document root. Needs mod_rewrite, mod_proxy,
# mod_proxy_http and mod_headers (Plesk has them). The website sets its own content security policy (a
# per-request nonce, apps/web/src/middleware.ts); this file adds the transport headers Caddy would.

# The pre-launch curtain, with app.ampmverse.com's user file so one login works on both sites. Remove it
# to go live. The ACME challenge stays open so Plesk's Let's Encrypt can renew the certificate.
AuthType Basic
AuthName "AMPM"
AuthUserFile /var/www/vhosts/app.ampmverse.com/httpdocs/.htpasswd
<RequireAny>
Require expr %{REQUEST_URI} =~ m#^/\.well-known/acme-challenge/#
Require valid-user
</RequireAny>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>

RewriteEngine On

# The root URL too: left on, mod_dir answers "/" by looking up its DirectoryIndex names, the lookup passes
# through the proxy rule below, and Next receives "/index.html" (its 404) instead of the home page.
DirectoryIndex disabled

# Every other request goes to the Next.js server in the production web container, on loopback only.
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.*)$ http://127.0.0.1:7102/$1 [P,L]
