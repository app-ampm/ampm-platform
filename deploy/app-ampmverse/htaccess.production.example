# httpdocs/.htaccess of app.ampmverse.com: the PRODUCTION client and staff portal on the shared Plesk
# box (D-138). Version-controlled so the box's web config lives in the repo (infra.md); deploys never
# overwrite it (deploy-web.sh's rsync excludes it, the .htpasswd it names and the .ampm-target marker).
# Plesk's nginx terminates TLS and hands these requests to Apache; this file does what Caddy does on a
# dedicated server: security headers, the /_api reverse proxy and the SPA fallback. Needs mod_rewrite,
# mod_proxy, mod_proxy_http and mod_headers (Plesk has them).

# The pre-launch password curtain was removed on 20 Nov 2026 at the user's decision (D-148): the portal is
# public. The production API accepts only the tokens of AMPM's own sign-in (D-142) and has no dev sign-in
# routes (404). WARNING: client sign-in codes are still shown on screen (CLIENT_OTP_SCREEN_ECHO, D-147), so
# anyone who knows a client's mobile can sign in as that client. Convert and invite no real client until SMS
# is wired and the on-screen code is off (runbook, "Wiring SMS").
#
# To put the curtain back, uncomment these lines. Everything stays behind the password except /_api, where
# the app sends its own Bearer token, but the client-code routes stay behind it too while codes are on
# screen. They send no Bearer, so they cannot trip fail2ban; a wrong Authorization scheme on a
# password-protected path counts toward Plesk's fail2ban (5 in 10 minutes = a ban).
# AuthType Basic
# AuthName "AMPM"
# AuthUserFile /var/www/vhosts/app.ampmverse.com/httpdocs/.htpasswd
# <RequireAny>
# Require expr "%{REQUEST_URI} =~ m#^/_api/# && %{REQUEST_URI} !~ m#^/_api/auth/(client|activation/client)/#"
# Require valid-user
# </RequireAny>

<IfModule mod_headers.c>
# Not launched yet (D-148): keep search engines from listing the portal. Remove this line at launch.
Header always set X-Robots-Tag "noindex, nofollow"
# HTTPS only, for a year (no includeSubDomains: other ampmverse.com names are not all ours to vouch for).
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\")"
# The portal's content security policy (security.md: no inline scripts). Scripts come from this origin
# and Razorpay's checkout; react-native-web writes its styles at run time, hence the inline styles; the
# browser talks to this origin's /_api and to Razorpay (sign-in is in-house, D-142). Report-Only first: the console
# lists what the live app would break, and the header switches to Content-Security-Policy once clean.
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Dot files (the target marker, any stray config) are never served; Let's Encrypt's challenge is.
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# API: /_api/* to the production API, published on the box's loopback only (compose.box.yml: 7101).
RewriteRule ^_api/(.*)$ http://127.0.0.1:7101/$1 [P,L]

# SPA fallback: a path that is not a real file or directory loads index.html, so a deep link such as
# /portal/requests/<id> opens the app and its router resolves it.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
</IfModule>
